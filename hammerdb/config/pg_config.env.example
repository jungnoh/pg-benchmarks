# PostgreSQL Connection Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=tpcc

# TPC-C Schema Configuration
# Warehouse count determines the scale factor
# Each warehouse is approximately 100MB of data
PG_WAREHOUSE_COUNT=10

# Number of virtual users for schema build
# More users = faster build, but more load on database
PG_BUILD_USERS=4

# Benchmark Configuration
# Number of concurrent virtual users during test
PG_VIRTUAL_USERS=4

# Ramp-up time before measuring (minutes)
PG_RAMPUP_MINUTES=2

# Benchmark duration (minutes)
PG_DURATION_MINUTES=5

# Use stored procedures (recommended for better performance)
PG_USE_STORED_PROCS=true

# PostgreSQL superuser for schema creation (optional)
# If not set, PG_USER will be used
# PG_SUPERUSER=postgres
# PG_SUPERUSER_PASSWORD=postgres
