#!/usr/bin/env bpftrace
/*
 * pg_page_intervals.bt
 *
 * Measure the re-access intervals of file-backed pages (identified by
 * inode + 8KB-aligned file offset) for PostgreSQL processes.
 *
 * Map entry counts (for I inodes, B blocks):
 *   @_ts    [ino, blk]      — I*B entries   (last-access timestamp)
 *   @_min   [ino, blk]      — I*B entries   (min re-access interval)
 *   @procs  [ino]           — I entries     (access count per inode, NOT per block)
 *   @fname  [ino]           — I entries
 *
 * Arguments:
 *   $1  UID of the PostgreSQL OS user
 *
 * Usage:
 *   sudo bpftrace pg_page_intervals.bt $(id -u postgres)
 */

BEGIN
{
    // $ stat -c '%d' /mnt/psql/18
    // 66305
    $st = (uint64)66305;
    @_target_dev = ((($st >> 8) & 0xFFF) << 20) | ($st & 0xFF) | (($st >> 12) & 0xFFF00);
    printf("Tracing UID %d, dev %u\n", $1, @_target_dev);
    printf("Press Ctrl-C to stop and display results.\n\n");
}

kprobe:vfs_read,
kprobe:vfs_write
/uid == $1/
{
    $file  = (struct file *)arg0;
    $inode = $file->f_inode;

    if (($inode->i_mode & 0xF000) != 0x8000) {
        return;
    }
    if ((uint64)$inode->i_sb->s_dev != @_target_dev) {
        return;
    }
    if ((uint64)arg2 == 0) {
        return;
    }

    $ino = (uint64)$inode->i_ino;
    $pos = *(int64 *)arg3;
    $now = nsecs;

    /* 8 KB block index — matches PostgreSQL BLCKSZ, halves map entries vs 4KB */
    $blk = (uint64)($pos >> 13);

    @fname[$ino] = str($file->f_path.dentry->d_name.name);

    /* ---- Interval tracking (single block per syscall) ---- */
    $prev = @_ts[$ino, $blk];
    if ($prev) {
        $delta = $now - $prev;
        $cur   = @_min[$ino, $blk];
        if (!$cur || $delta < $cur) {
            @_min[$ino, $blk] = $delta;
        }
    }
    @_ts[$ino, $blk] = $now;

    /* ---- Process tracking per inode (not per block) ---- */
    @procs[$ino] = count();
}

END
{
    printf("\n===FNAME_START===\n");
    print(@fname);
    printf("===FNAME_END===\n");

    printf("\n===MIN_NS_START===\n");
    print(@_min);
    printf("===MIN_NS_END===\n");

    printf("\n===PROCS_START===\n");
    print(@procs);
    printf("===PROCS_END===\n");

    clear(@_target_dev);
    clear(@_ts);
    clear(@fname);
    clear(@_min);
    clear(@procs);
}
