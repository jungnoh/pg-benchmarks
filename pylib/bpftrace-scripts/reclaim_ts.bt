// Map order: io worker, checkpointer, walwriter, autovaccum, background writer, etc

BEGIN {
    @_start_time = nsecs;
    printf("Start: %lld\n", nsecs(tai));
    @last_stolen = 0;
    for ($i : 0..6) {
        @last_io[$i] = 0;
        @last_misses[$i] = 0;
    }
}

END {
    clear(@stolen);
    clear(@last_stolen);
    clear(@_start_time);
    clear(@io);
    clear(@now_io);
    clear(@last_io);
    clear(@misses);
    clear(@now_misses);
    clear(@last_misses);
}

tracepoint:vmscan:mm_vmscan_lru_shrink_inactive /args->reclaim_flags & 0x2/ {
    @stolen += (uint64)args->nr_reclaimed;
}

tracepoint:filemap:mm_filemap_add_to_page_cache /comm == "postgres"/ {
    $mm = curtask->mm;
    $start = $mm->arg_start;
    $end = $mm->arg_end;
    $buf = buf(uptr($start), uptr($end - $start));

    $idx = 5;
    $first_char = *(uint8 *)uptr($start + 10);
    if ($first_char == 105) { // i
        $idx = 0;
    } else if ($first_char == 99) { // c
        $idx = 1;
    } else if ($first_char == 119) { // w
        $idx = 2;
    } else if ($first_char == 97) { // a
        $idx = 3;
    } else if ($first_char == 98) { // b
        $idx = 4;
    }
    @misses[$idx] = count();
}

kfunc:vfs_write, kfunc:vfs_read /comm == "postgres" && curtask->mm/ {
    $mm = curtask->mm;
    $start = $mm->arg_start;
    $end = $mm->arg_end;
    $buf = buf(uptr($start), uptr($end - $start));

    $idx = 5;
    $first_char = *(uint8 *)uptr($start + 10);
    if ($first_char == 105) { // i
        $idx = 0;
    } else if ($first_char == 99) { // c
        $idx = 1;
    } else if ($first_char == 119) { // w
        $idx = 2;
    } else if ($first_char == 97) { // a
        $idx = 3;
    } else if ($first_char == 98) { // b
        $idx = 4;
    }
    @io[$idx] = count();
}

interval:ms:50 {
    $now = @stolen;
    printf("S %10lld %8lld %lld\n", (nsecs - @_start_time) / 1000000, $now - @last_stolen, $now);
    @last_stolen = $now;

    clear(@now_io);
    for ($kv: @io) {
        $val = $kv.1;
        @now_io[$kv.0] = $val - @last_io[$kv.0];
        @last_io[$kv.0] = $val;
    }
    printf("I %10lld %4lld %4lld %4lld %4lld %4lld %4lld\n", (nsecs - @_start_time) / 1000000,
        @now_io[0], @now_io[1], @now_io[2], @now_io[3], @now_io[4], @now_io[5]);

    clear(@now_misses);
    for ($kv: @misses) {
        $val = $kv.1;
        @now_misses[$kv.0] = $val - @last_misses[$kv.0];
        @last_misses[$kv.0] = $val;
    }
    printf("M %10lld %4lld %4lld %4lld %4lld %4lld %4lld\n", (nsecs - @_start_time) / 1000000,
        @now_misses[0], @now_misses[1], @now_misses[2], @now_misses[3], @now_misses[4], @now_misses[5]);
}
