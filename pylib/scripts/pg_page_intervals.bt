#!/usr/bin/env bpftrace
/*
 * pg_page_intervals.bt
 *
 * Measure the re-access intervals of file-backed pages (identified by
 * device + inode + page-aligned file offset) for PostgreSQL processes.
 * Records which processes (comm, pid) touch each page and computes the
 * minimum time between consecutive accesses to the same page.
 *
 * Argument:
 *   $1  UID of the PostgreSQL OS user (e.g. $(id -u postgres))
 *
 * Usage (standalone):
 *   sudo bpftrace pg_page_intervals.bt $(id -u postgres)
 *
 * Usage (with sorted output via wrapper):
 *   sudo ./pg_page_intervals.sh [duration_secs] [pg_uid]
 *
 * Notes:
 *   - Pages are 4 KB (kernel PAGE_SIZE).  PostgreSQL uses 8 KB blocks,
 *     so each PG block spans 2 consecutive page indices.
 *   - Each vfs_read / vfs_write is decomposed into up to 16 pages
 *     (64 KB).  Larger I/Os are capped (rare for PostgreSQL).
 *   - If the map fills up (default 4096 entries in some bpftrace
 *     versions), pass  -M 131072  to bpftrace.
 */

BEGIN
{
    printf("Tracing file-backed page accesses for UID %d ...\n", $1);
    printf("Press Ctrl-C to stop and display results.\n\n");
}

/*
 * Probe both reads and writes through the VFS layer.
 * vfs_read  signature: (struct file *file, char __user *buf, size_t count, loff_t *pos)
 * vfs_write signature: (struct file *file, const char __user *buf, size_t count, loff_t *pos)
 */
kprobe:vfs_read,
kprobe:vfs_write
/uid == $1/
{
    $file  = (struct file *)arg0;
    $inode = $file->f_inode;

    /* ---- Only regular files (skip pipes, sockets, devs) ---- */
    if (($inode->i_mode & 0xF000) != 0x8000) {
        return;
    }

    $count = (uint64)arg2;
    if ($count == 0) {
        return;
    }

    $ino = (uint64)$inode->i_ino;
    $dev = (uint64)$inode->i_sb->s_dev;
    $pos = *(int64 *)arg3;
    $now = nsecs;

    /* ---- Remember inode → base filename for the report ---- */
    @fname[$dev, $ino] = str($file->f_path.dentry->d_name.name);

    /* ---- Compute the range of 4 KB pages touched ---- */
    $pg0 = (uint64)($pos >> 12);
    $pgN = (uint64)(($pos + $count - 1) >> 12);
    $n   = $pgN - $pg0 + 1;
    if ($n > 16) { $n = 16; }

    /* ---- Per-page interval tracking (unrolled) ---- */
    $i = (uint64)0;
    unroll(16) {
        if ($i < $n) {
            $pg   = $pg0 + $i;
            $prev = @_ts[$dev, $ino, $pg];

            if ($prev) {
                $delta = $now - $prev;
                $cur   = @_min[$dev, $ino, $pg];
                if (!$cur || $delta < $cur) {
                    @_min[$dev, $ino, $pg] = $delta;
                }
            }

            @_ts[$dev, $ino, $pg]                = $now;
            @procs[$dev, $ino, $pg, comm, pid]   = count();
        }
        $i++;
    }
}

/* ---- Output everything on Ctrl-C ---- */
END
{
    printf("\n===FNAME_START===\n");
    print(@fname);
    printf("===FNAME_END===\n");

    printf("\n===MIN_NS_START===\n");
    print(@_min);
    printf("===MIN_NS_END===\n");

    printf("\n===PROCS_START===\n");
    print(@procs);
    printf("===PROCS_END===\n");

    clear(@_ts);
    clear(@fname);
    clear(@_min);
    clear(@procs);
}
