# HammerDB PostgreSQL TPC-C Benchmark Configuration
# Copy this file to .envrc and modify as needed.
# If using direnv, it will automatically load these variables.

# =============================================================================
# PostgreSQL Connection Settings
# =============================================================================

# Database host
export HAMMERDB_PG_HOST=localhost

# Database port
export HAMMERDB_PG_PORT=5432

# Superuser credentials (used for schema creation/deletion)
export HAMMERDB_PG_SUPERUSER=postgres
export HAMMERDB_PG_SUPERUSER_PASS=postgres

# Default database to connect to before creating the benchmark database
export HAMMERDB_PG_DEFAULT_DBASE=postgres

# Benchmark user credentials
export HAMMERDB_PG_USER=postgres
export HAMMERDB_PG_PASS=postgres

# TPC-C benchmark database name
export HAMMERDB_PG_DBASE=tpcc

# =============================================================================
# Schema Build Settings (pg_build.py)
# =============================================================================

# Number of warehouses to create
# Each warehouse is approximately 100MB of data
# Recommended: 10 for testing, 100+ for production benchmarks
export HAMMERDB_PG_WAREHOUSES=10

# Number of virtual users for parallel data loading
# More users = faster loading, but more database load
export HAMMERDB_PG_BUILD_VU=4

# Use stored procedures for better benchmark performance
# Set to "true" or "false"
export HAMMERDB_PG_STORED_PROCS=true

# =============================================================================
# Benchmark Run Settings (pg_run.py)
# =============================================================================

# Number of virtual users to simulate during benchmark
export HAMMERDB_PG_RUN_VU=4

# Ramp-up time in minutes (warm-up period before measurement starts)
export HAMMERDB_PG_RAMPUP=2

# Test duration in minutes (how long to run the actual measurement)
export HAMMERDB_PG_DURATION=5

# Warehouse distribution mode
# "false" = each user gets dedicated warehouses (better for scaling tests)
# "true" = users can access all warehouses (more contention)
export HAMMERDB_PG_ALL_WAREHOUSE=false

# Enable time profiling for detailed timing statistics
# Set to "true" or "false"
export HAMMERDB_PG_TIME_PROFILE=false
